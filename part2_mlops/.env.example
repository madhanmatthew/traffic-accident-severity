# Copy to .env (git-ignored). All values are optional - defaults shown.

# Input produced by Part 1 (Parquet export) ...
FEATURES_PATH=../part1_data_pipeline/data/analytics/latest/ml_accident_features.parquet
# ... or read the table straight from the warehouse instead:
# FEATURES_DATABASE_URL=postgresql+psycopg2://traffic:change-me@localhost:5432/traffic_dw

TRAIN_END=2024-06-30
VALID_END=2024-09-30

# Local tracking store; use http://localhost:5000 to log to the docker MLflow server.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=traffic-severity
MODEL_NAME=traffic-severity-classifier
PROMOTION_MIN_DELTA=0.005

# Serving: leave empty to use models/champion; or load from the registry:
# MODEL_URI=models:/traffic-severity-classifier@champion
API_URL=http://localhost:8000
