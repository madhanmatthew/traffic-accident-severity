# Copy to .env and change the passwords. .env is git-ignored - never commit credentials.

# ---- PostgreSQL / PostGIS (docker compose) ----
POSTGRES_USER=traffic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traffic_dw

# Warehouse connection used by the pipeline and the dashboard.
# Leave empty to use the local SQLite fallback (data/warehouse/traffic_warehouse.db).
# Running the pipeline on the host against the docker database:
# DATABASE_URL=postgresql+psycopg2://traffic:change-me@localhost:5432/traffic_dw
DATABASE_URL=

# ---- Airflow admin login ----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# ---- Pipeline settings ----
STATS19_YEARS=2023,2024
# 0 = all collisions; e.g. 20000 for a quick demo sample
MAX_COLLISIONS=0
FORCE_DOWNLOAD=false
WEATHER_ENABLED=true
WEATHER_GRID_DEG=1.0
MAX_REJECT_RATE=0.05
